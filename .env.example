# Copy to .env (next to app.py) and fill in. .env is gitignored, and the app
# reads it itself at startup (values already in the environment win). Keep it
# mode 600: it is the only copy of the key. POLY_ENV_FILE overrides the path.
ANTHROPIC_API_KEY=

# Optional anti-abuse overrides (defaults shown in docker-compose.yml):
# FORM_TOKEN_SECRET=change-me-to-a-stable-random-string
# MODERATION_ENABLED=1
# CAPTCHA_SECRET=...        # pair with CAPTCHA_SITEKEY or browsers break
# CAPTCHA_SITEKEY=...
